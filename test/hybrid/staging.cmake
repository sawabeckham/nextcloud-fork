cmake_minimum_required(VERSION 3.16)
set(stage "${CMAKE_CURRENT_LIST_DIR}/../../cmake/modules/StageMacRuntime.cmake")
set(fixture "${CMAKE_CURRENT_BINARY_DIR}/runtime staging fixture")
file(MAKE_DIRECTORY "${fixture}")
set(input "${fixture}/library.35.dylib")
set(output "${fixture}/Nextcloud Fork.app/Contents/Frameworks/library.0.dylib")
file(WRITE "${input}" "runtime library fixture\n")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${input}" "-DOUTPUT=${output}" -P "${stage}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Runtime staging failed with spaces in bundle path")
endif()
file(SHA256 "${input}" original)
file(SHA256 "${output}" staged)
if(NOT original STREQUAL staged)
    message(FATAL_ERROR "Staged runtime contents differ")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${fixture}/missing" "-DOUTPUT=${output}" -P "${stage}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
    message(FATAL_ERROR "A missing library must fail packaging")
endif()
